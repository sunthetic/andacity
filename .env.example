# Andacity environment configuration example.
# Copy to .env and fill in real values. Never commit .env to source control.

# ── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Required.
# Format: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/andacity

# Maximum DB pool connections per instance (default: 10)
DB_POOL_MAX=10

# Set to "true" to allow read queries. If unset, DB reads are disabled.
DB_READS_ENABLED=true

# ── Origins and CSRF ──────────────────────────────────────────────────────────

# Production origin — required for Qwik CSRF protection on form submissions.
# Must match the exact origin users access the site from (no trailing slash).
# Docker: set via APP_ORIGIN build arg or ORIGIN env var in the container.
# Example production value:
ORIGIN=https://andacity.com

# Optional: override the public base URL used for canonical URLs, sitemaps,
# and JSON-LD. If unset, Andacity derives it from the request URL.
PUBLIC_BASE_URL=https://andacity.com

# ── OG Image signing ──────────────────────────────────────────────────────────

# Secret used to sign OG image generation requests. Generate a random string.
OG_SIGNING_SECRET=change-me

# ── Analytics ────────────────────────────────────────────────────────────────

# No third-party analytics provider is configured by default.
# Current behavior: server-side console.info logging only (no external service).
# To add a provider, wire it into src/components/analytics/PageView.tsx.

# ── Notifications ────────────────────────────────────────────────────────────

# Required only if notification features are enabled.
# NOTIFICATION_PROVIDER=resend
# RESEND_API_KEY=re_...
# NOTIFICATION_FROM_EMAIL=noreply@andacity.com
# NOTIFICATION_FROM_NAME=Andacity

# ── Payments (Stripe) ────────────────────────────────────────────────────────

# Required only if payment/booking features are enabled.
# STRIPE_SECRET_KEY=sk_live_...
# PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Feature flags ────────────────────────────────────────────────────────────

# Set to "true" to enable booking flows for each vertical.
# ANDACITY_BOOKING_FLIGHT_ENABLED=false
# ANDACITY_BOOKING_HOTEL_ENABLED=false
# ANDACITY_BOOKING_CAR_ENABLED=false
