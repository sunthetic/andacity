# Andacity environment configuration example.
# Copy to .env and fill in real values. Never commit .env to source control.

# ── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Required.
# Format: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/andacity

# Maximum DB pool connections per instance (default: 10)
DB_POOL_MAX=10

# Set to "true" to allow read queries. If unset, DB reads are disabled.
DB_READS_ENABLED=true

# ── Origins and CSRF ──────────────────────────────────────────────────────────

# Production origin — required for Qwik CSRF protection on form submissions.
# Must match the exact origin users access the site from (no trailing slash).
# Docker: set via APP_ORIGIN build arg or ORIGIN env var in the container.
# Example production value:
ORIGIN=https://andacity.com

# Optional: override the public base URL used for canonical URLs, sitemaps,
# and JSON-LD. If unset, Andacity derives it from the request URL.
PUBLIC_BASE_URL=https://andacity.com

# ── OG Image signing ──────────────────────────────────────────────────────────

# Secret used to sign OG image generation requests. Generate a random string.
OG_SIGNING_SECRET=change-me

# ── Contact emails ────────────────────────────────────────────────────────────

# General contact address shown on /contact.
# Verify this address is monitored before launch.
CONTACT_EMAIL=hello@andacity.com

# Privacy-related contact address shown on /privacy.
PRIVACY_EMAIL=privacy@andacity.com

# Legal contact address shown on /terms.
LEGAL_EMAIL=legal@andacity.com

# ── Analytics ────────────────────────────────────────────────────────────────

# Provider to activate. Leave empty for first-party server logging only (default).
# Supported values: cloudflare | ga4
# Note: PUBLIC_* vars are baked into the client bundle at build time.
# Change the provider requires a rebuild and redeploy.
PUBLIC_ANALYTICS_PROVIDER=

# Cloudflare Web Analytics token — required when PUBLIC_ANALYTICS_PROVIDER=cloudflare.
# Cookieless. Obtain from: Cloudflare Dashboard → Analytics → Web Analytics.
# No cookies are set. CSP is updated automatically at build time.
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Google Analytics 4 Measurement ID — required when PUBLIC_ANALYTICS_PROVIDER=ga4.
# Format: G-XXXXXXXXXX. Obtain from: GA4 Admin → Data Streams.
# GA4 sets analytics cookies. Add a cookie disclosure banner if required in your jurisdiction.
# CSP is updated automatically at build time.
PUBLIC_GA_MEASUREMENT_ID=

# ── Error monitoring ──────────────────────────────────────────────────────────

# Client-side error reports are always sent to /api/errors (first-party, console.error logging).
# For full Sentry monitoring, install @sentry/browser, initialize with the DSN below,
# and configure source map uploads using SENTRY_AUTH_TOKEN in CI.

# Sentry DSN for browser error reporting. Leave empty to use first-party logging only.
# Obtain from: Sentry project → Settings → Client Keys (DSN).
# The DSN is intentionally public — it is embedded in the client bundle.
PUBLIC_SENTRY_DSN=

# Sentry auth token — used only in CI for source map uploads. Never included in app code.
# Obtain from: Sentry → Settings → Auth Tokens.
SENTRY_AUTH_TOKEN=

# Sentry organization slug.
SENTRY_ORG=

# Sentry project slug.
SENTRY_PROJECT=

# Sentry environment tag sent with events (default: production).
SENTRY_ENVIRONMENT=production

# ── Notifications ────────────────────────────────────────────────────────────

# Required only if notification features are enabled.
# NOTIFICATION_PROVIDER=resend
# RESEND_API_KEY=re_...
# NOTIFICATION_FROM_EMAIL=noreply@andacity.com
# NOTIFICATION_FROM_NAME=Andacity

# ── Payments (Stripe) ────────────────────────────────────────────────────────

# Required only if payment/booking features are enabled.
# STRIPE_SECRET_KEY=sk_live_...
# PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Feature flags ────────────────────────────────────────────────────────────

# Set to "true" to enable booking flows for each vertical.
# ANDACITY_BOOKING_FLIGHT_ENABLED=false
# ANDACITY_BOOKING_HOTEL_ENABLED=false
# ANDACITY_BOOKING_CAR_ENABLED=false
